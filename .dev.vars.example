# ローカル開発用の環境変数サンプル
# このファイルをコピーして .dev.vars を作成し、実際の値を設定してください
# .dev.vars は .gitignore により git 管理外です

# ── オーナー（合言葉）モードの AI 設定 ─────────────────────────────
# プロバイダとモデルは環境変数だけで切り替えられます（コード修正は不要）。

# AI プロバイダ: gemini | anthropic | openai（未指定は gemini）
AI_PROVIDER=gemini

# モデル名（未指定はプロバイダ別の既定値）
#   gemini    → gemini-3.8-flash
#   anthropic → claude-sonnet-4-6
#   openai    → gpt-4o-mini
# 例: AI_MODEL=gemini-3.8-flash / AI_MODEL=claude-sonnet-4-6 / AI_MODEL=gpt-4o-mini
AI_MODEL=gemini-3.8-flash

# API キー（優先）。プロバイダに関わらず共通で使えます
AI_API_KEY=your-api-key-here

# AI_API_KEY が未設定のときのフォールバック（プロバイダに合わせて 1 つだけ設定すればよい）
# GEMINI_API_KEY=your-gemini-api-key-here
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# オーナーモードのパスコード（画面の設定で入力する合言葉。必須）
OWNER_PASSCODE=your-passcode-here

# ── その他 ─────────────────────────────────────────────────────────
# モックモード（1 = AI を呼ばず固定レスポンスを返す。ヘッダーのモード指定より優先される）
LOGI_MOCK=1
